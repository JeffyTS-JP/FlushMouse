//
// Icon
//

// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.
IDI_FLUSHMOUSE          ICON                    "FlushMouse.ico"

IDI_SMALL               ICON                    "small.ico"

IDI_SYNTPHELPER         ICON                    "..\\SynTP_Receiver\\SynTP_Receiver.ico"


/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDC_FLUSHMOUSE MENU
BEGIN
    POPUP "ファイル(&F)"
    BEGIN
        MENUITEM "終了する(&X)",                    IDM_EXIT
    END
    POPUP "ヘルプ(&H)"
    BEGIN
        MENUITEM "バージョン情報(&A)...",           IDM_ABOUT
    END
END

IDR_TT_MENU MENU
BEGIN
    POPUP "PopupMenu"
    BEGIN
        MENUITEM "FlushMouse Menu",                 IDR_TT_MENU
        MENUITEM SEPARATOR
        MENUITEM "基本動作設定... (&S)",            IDR_TT_SETTING
        MENUITEM "IME モード表示設定... (&I)",      IDR_TT_IMEMODE
        MENUITEM "SynTP Helper... (&H)",            IDR_TT_SYNTPHELPER
        MENUITEM "バージョン... (&A)",              IDR_TT_ABOUT
        MENUITEM SEPARATOR
        MENUITEM "終了 (&X)",                       IDR_TT_QUIT
    END
END


/////////////////////////////////////////////////////////////////////////////
